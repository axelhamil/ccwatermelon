{
	"name": "ccwatermelon",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"ccwatermelon-config": "src/cli.ts"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"config": "bun run src/cli.ts",
		"test": "bun test",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"format": "biome format --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/bun": "^1.4.2",
		"husky": "^9.1.7",
		"knip": "^6.40.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"license": "MIT",
	"description": "A fast, configurable Claude Code statusline: context, cost history and rate-limit gauges at a glance.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axelhamil/ccwatermelon.git"
	},
	"keywords": [
		"claude-code",
		"statusline",
		"cli",
		"bun",
		"terminal"
	]
}
