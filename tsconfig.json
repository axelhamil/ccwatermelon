{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ESNext"],
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["src/**/*", "scripts/**/*", "__tests__/**/*"]
}
